<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/about.css">

<div class="about-wrapper">
    <div class="backward-btn">
        <i class="fa-solid fa-backward"></i>
    </div>
    <div class="container">
        
        <header class="about-header-section">
            <h1 class="about-brand-title">exploRome</h1>
            <p class="about-brand-subtitle">Bridging the gap between curious travelers and local community spaces.</p>
        </header>

        <section class="row align-items-center mb-5">
            <div class="col-lg-12">
                <h2 class="about-heading">Rediscover Wandering</h2>
                <p class="about-lead-text">
                    <strong>exploRome</strong> isn't just a place to find a bed for the night—it is your gateway to authentic, immersive exploration. Inspired by the timeless allure of the historic wanderer and built for the modern adventurer, our platform bridges the gap between curious travelers and unique local stays. 
                </p>
                <p class="about-lead-text">
                    Whether you are looking for a rustic countryside villa, a sleek metropolitan loft, or a hidden architectural gem, exploRome curates spaces that feel less like a temporary lodging and more like a home base for your journey.
                </p>
            </div>
        </section>

        <section class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-compass"></i>
                    </div>
                    <h4 class="feature-card-title">Curated Listings</h4>
                    <p class="text-muted mb-0">Every property on exploRome is vetted to ensure it offers character, comfort, and a distinct sense of local placement.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h4 class="feature-card-title">Secure Authentication</h4>
                    <p class="text-muted mb-0">Our streamlined modal authentication system verifies security boundaries seamlessly without interrupting your booking workflows.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-house-user"></i>
                    </div>
                    <h4 class="feature-card-title">Community Driven</h4>
                    <p class="text-muted mb-0">We connect you directly with passionate local hosts who don't just share their spaces, but share the heartbeat of their cities.</p>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <div class="text-center mb-4">
                <h2 class="about-heading">The exploRome Experience</h2>
            </div>
            <div class="table-responsive custom-comparison-table">
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50%;"><i class="fa-solid fa-user-astronaut me-2"></i>For Explorers</th>
                            <th style="width: 50%;"><i class="fa-solid fa-hotel me-2"></i>For Hosts</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <ul class="table-bullet-list">
                                    <li><strong>Discover Hidden Gems:</strong> Filter and search through an array of unique accommodations tailored to your travel style.</li>
                                    <li><strong>Instant Real-Time Booking:</strong> Secure your stay seamlessly with quick layouts designed to protect your travel plans.</li>
                                    <li><strong>Tailored Recommendations:</strong> Find stays near the specific cultural landmarks and local hotspots you want to explore.</li>
                                </ul>
                            </td>
                            <td>
                                <ul class="table-bullet-list">
                                    <li><strong>Share Your Space:</strong> List your property effortlessly and connect with respectful travelers from around the world.</li>
                                    <li><strong>Earn Extra Income:</strong> Turn your spare room, second home, or unique property into a thriving boutique hospitality business.</li>
                                    <li><strong>Complete Control:</strong> Manage your calendar, pricing, and guest requirements with intuitive hosting tools.</li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="philosophy-blockquote text-center">
            <blockquote class="blockquote mb-0">
                <p class="philosophy-text">"To travel is to live, and to explore is to truly understand."</p>
                <footer class="blockquote-footer mt-2">The <span style="color: #a50591; font-weight: 600;">exploRome</span> Operational Philosophy</footer>
            </blockquote>
        </section>

    </div>
</div>