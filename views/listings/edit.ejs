                <select class="star-rating" name="rating" required>
                    <option value="">Select a rating</option>
                    <option value="5">Excellent</option>
                    <option value="4">Very Good</option>
                    <option value="3">Average</option>
                    <option value="2">Poor</option>
                    <option value="1">Terrible</option>
                </select>
            </div>
            <br>
            <textarea name="feedback" id="" class="form-control" required></textarea>
            <div class="invalid-feedback">Please give feedback!</div>
            <br>
            <button class="btn">Submit</button>
        </form>
    </div>
<%}  %>

<% if(listing.reviews.length!==0){ %>
<div class="all-reviews">
    <hr class="col-10 mx-auto border-black opacity-100">
    <h3 class="col-10 mx-auto">All Reviews</h3>
    <div class="reviews-main-container">
        <div class="reviews row row-cols-1 row-cols-md-2 mb-2 mt-2 g-4">
            <% for(let review of listing.reviews){ %>
            <div class="col">
                <div class="review h-100 flex-column d-flex justify-content-between" style="min-width: 221px;">
                    <h5><b>@</b><mark><%= review.author.username %></mark></h5>
                    <p><%= review.feedback %></p>
                    <form action="/listing/<%= listing._id %>/review/<%=review._id %>?_method=DELETE" method="post" class="d-flex">
                        <div class="star-delete-btn w-100 d-flex justify-content-between align-items-center" style="min-width: 205px;">
                            <div class="review-stars d-flex flex-nowrap">
                                <% for(let i=1;i<=5;i++){ %>    
                                    <% if(i<=review.rating){ %>
                                        <i class="fa-solid fa-star"></i>
                                    <% }else{ %>
                                        <i class="fa-regular fa-star"></i>
                                    <% } %>
                                <% } %>
                            </div>
                            <% if(currentUser && currentUser._id.equals(review.author._id)){ %>
                            <div class="delete-review-button">
                                <button class="btn btn-dark">Delete</button>  
                            </div>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>
<% } %>

