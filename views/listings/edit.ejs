<script src="/js/map.js"></script>
<script>
    const input = document.querySelector("#location");
    const suggestionsList = document.getElementById("suggestions-list");
    let debounceTimer;

    // Listen to user typing
    input.addEventListener("input", (e) => {
        const query = e.target.value.trim();
        clearTimeout(debounceTimer);

        if (query.length < 3) {
            suggestionsList.style.display = "none";
            return;
        }

        // Wait 300ms after user stops typing before fetching
        debounceTimer = setTimeout(() => {
            fetchSuggestions(query);
        }, 300);
    });

    // Fetch place suggestions from Nominatim
   async function fetchSuggestions(userInput) {
    try {
        const url = `https://photon.komoot.io/api/?q=${encodeURIComponent(userInput)}&limit=5`;
        const response = await fetch(url);
        const result = await response.json();

        // Convert Photon GeoJSON format to standard place objects
        const places = result.features.map(f => {
            const p = f.properties;
            
            // 1. Build a richer label (includes town, village, or district if city is missing)
            const nameParts = [
                p.name, 
                p.district || p.suburb, 
                p.city || p.town || p.village || p.county, 
                p.state, 
                p.country
            ].filter(Boolean);

            // 2. Remove duplicate values if place name matches city name
            const uniqueParts = [...new Set(nameParts)];

            return {
                display_name: uniqueParts.join(", "),
                lon: f.geometry.coordinates[0],
                lat: f.geometry.coordinates[1],
                address: { country: p.country }
            };
        });

        renderSuggestions(places);
    } catch (error) {
        console.error("Autocomplete fetch error:", error);
    }
}

    // Render suggestions dropdown
    function renderSuggestions(places) {
        suggestionsList.innerHTML = "";

        if (!places || places.length === 0) {
            suggestionsList.style.display = "none";
            return;
        }

        places.forEach((place) => {
            const li = document.createElement("li");
            li.textContent = place.display_name;
            li.style.padding = "10px 12px";
            li.style.cursor = "pointer";
            li.style.borderBottom = "1px solid #f0f0f0";

            // Hover effect
            li.addEventListener("mouseover", () => (li.style.background = "#f8f9fa"));
            li.addEventListener("mouseout", () => (li.style.background = "white"));

            // Handle selecting a place
            li.addEventListener("click", () => {
                input.value = place.display_name;

                // Extract coordinates
                const lon = parseFloat(place.lon);
                const lat = parseFloat(place.lat);

                document.getElementById("longitude").value = lon;
                document.getElementById("latitude").value = lat;

                // Auto-fill country field if present in Nominatim response
                if (place.address && place.address.country) {
                    document.getElementById("country").value = place.address.country;
                }

                suggestionsList.style.display = "none";
            });

            suggestionsList.appendChild(li);
        });

        suggestionsList.style.display = "block";
    }

    // Hide suggestions if user clicks anywhere outside
    document.addEventListener("click", (e) => {
        if (!input.contains(e.target) && !suggestionsList.contains(e.target)) {
            suggestionsList.style.display = "none";
        }
    });
</script>