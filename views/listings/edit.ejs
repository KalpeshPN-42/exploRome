<% layout("./layouts/boilerplate.ejs") %>
<link href="/css/star-rating.css" rel="stylesheet">
<link rel="stylesheet" href="/css/edit.css">
<style>
    body { margin: 0; padding: 0; }
    #map {width: 82% !important; height: 25rem !important;border: solid black 2px;}
</style>
<script>
    const geometry = <%- JSON.stringify(listing.geometry || {}) %>;
    const coordinates = geometry && geometry.coordinates ? geometry.coordinates : [73.8567, 18.5204];
    const listingLocation=<%-JSON.stringify(listing.location)%>;
