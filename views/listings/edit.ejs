<div class="edit-div" style="overflow-x: hidden;">
    <div class="image-edit-div">
        <img src="<%= listing.image.url %>" alt="image" class="image edit" onerror="this.src='/images/commonImage.png'">
    </div>
    <%if(currentUser && currentUser._id.equals(listing.owner._id)){%>
    <form method="post" action="/listing/<%=listing._id%>?_method=PATCH" class="edit-form needs-validation" enctype="multipart/form-data" novalidate>
        <div class="container col-10 mt-5">
            <div class="mb-3">
                <p><b>Owner:@</b><mark><%= listing.owner.username %></mark></p>
            </div>
            <div class="mb-3">
                <label for="title" class="form-label"><b>Title</b></label>
                <input type="text" class="form-control" id="title" placeholder="ex. kalpataru nivas" value="<%= listing.title %>" name="title" maxlength="42" required>
                <div class="invalid-feedback">Please enter title</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label"><b>Description</b></label>
                <textarea class="form-control" id="description" rows="3" name="description" placeholder="enter the description"><%= listing.description %></textarea>
            </div>
            <div class="mb-3">
                <input type="file" class="form-control" id="image" placeholder="Add Image" name="image">
            </div>

        <div class="row">
            <div class="col-sm-6 price mb-3">
                <label for="price" class="form-label"><b>Price</b></label>
                <input
                    type="number"
                    class="form-control"
                    id="price"
                    placeholder="Add the Price"
                    name="price"
                    min="0"
                    max="9999999"
                    value="<%= listing.price %>"
                    required
                />
                <div class="invalid-feedback">Please enter price per night</div>
                <div class="valid-feedback">Ok</div>
            </div>

            <!-- Added position-relative to properly attach the dropdown -->
            <div class="col-sm-6 location mb-3 position-relative">
                <label for="location" class="form-label"><b>Location</b></label>
                <input
                    type="text"
                    class="form-control"
                    id="location"
                    placeholder="Add the location"
                    name="location"
                    autocomplete="off"
                    value="<%= listing.location %>" 
                    required
                />
                <div class="invalid-feedback">Please provide location!</div>
                <div class="valid-feedback">Nice!</div>
                
                <!-- Suggestions Dropdown -->
                <ul
                    id="suggestions-list"
                    class="shadow-sm rounded"
                    style="
                        position: absolute;
                        top: 100%;
                        left: 12px;
                        right: 12px;
                        background: white;
                        border: 1px solid #ced4da;
                        list-style: none;
                        margin: 0;
                        padding: 0;
                        display: none;
                        max-height: 200px;
                        overflow-y: auto;
                        z-index: 1050;
                    "
                ></ul>
            </div>
        </div>

        <input type="hidden" id="longitude" name="longitude" />
        <input type="hidden" id="latitude" name="latitude" />
            <div class="mb-3">
                <label for="country" class="form-label"><b>Country</b></label>
                <input type="text" class="form-control" id="country" placeholder="ex. India" value="<%= listing.country %>" name="country" required>
                <div class="invalid-feedback">Country is required</div>
            </div>
            <div class="row-btns">
                <div class="col-1">
                    <button class="btn edit">Edit</button>
                </div>
                <div>
                    <button class="btn delete" form="deleteForm">Delete</button>
                </div>
            </div>
        </div>
    </form>
    <form method="post" action="/listing/<%= listing._id %>?_method=DELETE" id="deleteForm">
        <!-- this is delete form linked to the button inside the above edit form  -->
    </form>
    <%}else{%>
    <form method="post" action="/listing/<%=listing._id%>?_method=PATCH" class="edit-form needs-validation" novalidate>
        <div class="container col-10 mt-5">
            <div class="mb-3">
                <p><b>Owner:@</b><mark><%= listing.owner.username %></mark></p>
            </div>
            <div class="mb-3">
                <label for="title" class="form-label"><b>Title</b></label>
                <input type="text" class="form-control" id="title" placeholder="ex. kalpataru nivas" value="<%= listing.title %>" name="title" maxlength="42" disabled>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label"><b>Description</b></label>
                <textarea class="form-control" id="description" rows="3" name="description" placeholder="enter the description" disabled><%= listing.description %></textarea>
            </div>
            <div class="row">
                <div class="col-sm-6 price">
                    <label for="price" class="form-label"><b>Price</b></label>
                    <input type="number" class="form-control" id="price" placeholder="ex. ₹4200"  min="0"  max="9999999999" value="<%= listing.price %>" name="price" disabled>
                </div>
                <div class="col-sm-6 location">
                    <label for="location" class="form-label"><b>Location</b></label>
                    <input type="text" class="form-control" id="location" placeholder="ex. Maharashtra" value="<%= listing.location %>" name="location" disabled>
                </div>
            </div>
            <div class="mb-3">
                <label for="country" class="form-label"><b>Country</b></label>
                <input type="text" class="form-control" id="country" placeholder="ex. India" value="<%= listing.country %>" name="country" disabled>
            </div>
        </form>
    <% } %>
</div>


<%if(currentUser){%>
    <hr class="col-10 mx-auto border-black opacity-100">
    
    <div class="add-review">
        <h3>Add Review</h3>
        <form action="/listing/<%= listing._id %>/review" novalidate class="new-form needs-validation" method="post">
