<% layout("./layouts/boilerplate.ejs") %>
<link rel="stylesheet" href="/css/modal-login-signup.css">

<div class="modal-overlay">
    <div class="modal-content hidden row">
        <form action="" class="new-form needs-validation login-form" novalidate>
            <div class="close-button d-flex justify-content-end">
                <a href=""><i class="fa-solid fa-xmark"></i></a>
            </div>

            <div class="d-flex flex-column justify-content-center email-div mb-2">
                <label for="email" class="form-label"> What's your Email?</label>
                <input id="email" type="email" class="form-control" placeholder="email">
            </div>

            <div class="d-flex flex-column justify-content-center password-div mb-2">
                <label for="password" class="form-label">What's your Password?</label>
                <input id="password" type="password" class="form-control" placeholder="password">
            </div>
            
            <div class="d-flex justify-content-between align-items-center login-create-account-btn-div mb-2">
                <a href="/user/signup">Create account</a>
                <button class="btn btn-dark">Login</button>
            </div>
        </form>
    </div>  
</div>








