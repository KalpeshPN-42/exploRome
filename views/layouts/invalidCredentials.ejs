<% if (invalidCredentials && invalidCredentials.length > 0) { %>
    <div class="invalid-credentials-flash-div alert alert-warning alert-dismissible fade show" role="alert">
        <strong><%= invalidCredentials %></strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>