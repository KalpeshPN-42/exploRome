<link rel="stylesheet" href="/css/modal-login-signup.css">

<div class="modal-content row login hidden-login">
    <form action="/user/login" method="post" class="new-form needs-validation login-form" novalidate>
        <div class="close-button d-flex justify-content-end">
            <i class="fa-solid fa-xmark"></i>
        </div>
        
        <div class="invalid-credentials-flash-div hidden alert alert-warning alert-dismissible fade show" role="alert">
            <strong></strong>
            <button type="button" class="btn-close" aria-label="Close"></button>
        </div>


        <div class="d-flex flex-column justify-content-center email-div mb-2">
            <label for="email" class="form-label"> What's your Email?</label>
            <input id="email" type="email" class="form-control" placeholder="email" name="email" required>
            <div class="invalid-feedback" style="color: white;">Please enter email!</div>
        </div>

        <div class="d-flex flex-column justify-content-center password-div mb-2">
            <label for="password" class="form-label">What's your Password?</label>
            <input id="password" type="password" class="form-control" placeholder="password" name="password" required>
            <div class="invalid-feedback" style="color: white;">Please enter password!</div>
        </div>
        
        <div class="d-flex justify-content-between align-items-center login-btn-div mb-2">
            <a href="#">Create account</a>
            <button class="btn btn-dark">Login</button>
        </div>
    </form>
</div>  